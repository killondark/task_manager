<% content_for :title, "Главная" %>

<h1 class="text-2xl font-bold text-slate-900">Дашборд</h1>

<div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
  <div class="rounded-xl bg-white p-5 shadow-sm border border-slate-100">
    <p class="text-sm font-medium text-slate-500">Всего</p>
    <p class="mt-1 text-3xl font-bold text-slate-900"><%= @total_tasks %></p>
  </div>

  <% Task.statuses.each_key do |status| %>
    <div class="rounded-xl bg-white p-5 shadow-sm border border-slate-100">
      <p class="text-sm font-medium text-slate-500"><%= status.humanize %></p>
      <p class="mt-1 text-3xl font-bold <%= status_count_color(status) %>"><%= @status_counts[status].to_i %></p>
    </div>
  <% end %>
</div>

<div class="mt-6 rounded-xl bg-white p-5 shadow-sm border border-slate-100">
  <div class="flex items-center justify-between">
    <p class="text-sm font-medium text-slate-500">Прогресс выполнения</p>
    <p class="text-sm font-bold text-slate-900"><%= @progress_percent %>%</p>
  </div>
  <div class="mt-3 h-2.5 w-full rounded-full bg-slate-100">
    <div class="h-2.5 rounded-full bg-indigo-500 transition-all duration-500"
         style="width: <%= @progress_percent %>%"></div>
  </div>
</div>

<section class="mt-6 rounded-xl bg-white p-5 shadow-sm border border-slate-100">
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-semibold text-slate-900">Последние задачи</h2>
    <%= link_to "Все задачи", tasks_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
  </div>

  <% if @recent_tasks.any? %>
    <ul class="mt-4 divide-y divide-slate-100">
      <% @recent_tasks.each do |task| %>
        <li class="flex items-center justify-between py-3">
          <%= link_to task.title, task, class: "font-medium text-slate-800 hover:text-indigo-600" %>
          <span class="rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_badge_class(task.status) %>">
            <%= task.status.humanize %>
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-sm text-slate-500">Задач пока нет. <%= link_to "Создайте первую задачу", new_task_path, class: "text-indigo-600 hover:text-indigo-800" %></p>
  <% end %>
</section>