<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Task Manager" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Task Manager">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-800 antialiased">
    <header class="bg-white shadow-sm">
      <nav class="mx-auto flex max-w-5xl items-center gap-6 px-5 py-4">
        <%= link_to "Task Manager", root_path, class: "text-lg font-bold text-slate-900" %>
        <div class="flex gap-4 text-sm font-medium">
          <%= link_to "Главная", root_path,
            class: "px-3 py-1.5 rounded-lg transition-colors " + (current_page?(root_path) ? "bg-indigo-50 text-indigo-700" : "text-slate-600 hover:text-slate-900") %>
          <%= link_to "Задачи", tasks_path,
            class: "px-3 py-1.5 rounded-lg transition-colors " + (controller_name == "tasks" ? "bg-indigo-50 text-indigo-700" : "text-slate-600 hover:text-slate-900") %>
        </div>
      </nav>
    </header>

    <div id="flash">
      <% flash.each do |type, message| %>
        <%= render "layouts/flash_message", type: type, message: message %>
      <% end %>
    </div>

    <main class="mx-auto max-w-5xl px-5 py-8">
      <%= yield %>
    </main>
  </body>
</html>