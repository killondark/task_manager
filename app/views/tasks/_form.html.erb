<%= form_with(model: task) do |form| %>
  <% if task.errors.any? %>
    <div class="mb-4 rounded-lg border border-red-200 bg-red-50 p-4">
      <h2 class="mb-1 font-medium text-red-700">Не удалось сохранить задачу:</h2>
      <ul class="list-disc pl-5 text-sm text-red-600">
        <% task.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4">
    <div class="field">
      <%= form.label :title, "Заголовок", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= form.text_field :title, class: "w-full rounded-lg border border-slate-200 px-3 py-2 text-slate-800 focus:border-indigo-500 focus:outline-none" %>
    </div>

    <div class="field">
      <%= form.label :description, "Описание", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= form.text_area :description, rows: 5, class: "w-full rounded-lg border border-slate-200 px-3 py-2 text-slate-800 focus:border-indigo-500 focus:outline-none" %>
    </div>

    <div class="field">
      <%= form.label :status, "Статус", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= form.select :status, Task.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "w-full rounded-lg border border-slate-200 px-3 py-2 text-slate-800 focus:border-indigo-500 focus:outline-none" %>
    </div>

    <div class="field">
      <%= form.label :priority, "Приоритет", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= form.number_field :priority, class: "w-full rounded-lg border border-slate-200 px-3 py-2 text-slate-800 focus:border-indigo-500 focus:outline-none" %>
    </div>

    <div class="field">
      <%= form.label :deadline, "Дедлайн", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= form.datetime_local_field :deadline, class: "w-full rounded-lg border border-slate-200 px-3 py-2 text-slate-800 focus:border-indigo-500 focus:outline-none" %>
    </div>

    <div class="actions flex items-center gap-3 pt-2">
      <%= form.submit "Сохранить задачу", class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-indigo-700" %>
      <button type="button"
              class="rounded-lg px-4 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-100"
              data-action="modal#close">Отмена</button>
    </div>
  </div>
<% end %>