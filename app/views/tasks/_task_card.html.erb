<div id="<%= dom_id(task) %>"
     class="flex flex-col gap-3 rounded-xl bg-white p-5 shadow-sm border border-slate-100 transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 animate-fade-in">
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-base font-semibold text-slate-900">
      <%= link_to task.title, task, class: "hover:text-indigo-600" %>
    </h3>
    <span class="shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_badge_class(task.status) %>">
      <%= task.status.humanize %>
    </span>
  </div>

  <div class="flex items-center gap-4 text-sm text-slate-500">
    <span class="flex items-center gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full <%= priority_indicator_class(task.priority) %>"></span>
      Приоритет <%= priority_label(task.priority) || "—" %>
    </span>
    <span>
      <%= task.deadline ? l(task.deadline, format: :short) : "Без дедлайна" %>
    </span>
  </div>

  <div class="mt-auto flex items-center justify-between border-t border-slate-100 pt-3">
    <%= form_with url: status_task_path(task), method: :patch,
                  data: { controller: "status" }, class: "contents" do |form| %>
      <%= form.label :status, "Статус", class: "sr-only" %>
      <%= form.select :status, Task.statuses.keys.map { |s| [s.humanize, s] },
            { selected: task.status },
            class: "rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none",
            data: { action: "change->status#submit" } %>
    <% end %>

    <div class="flex items-center gap-3 text-sm">
      <%= link_to "Редактировать", edit_task_path(task), data: { turbo_frame: "task_modal" }, class: "text-indigo-600 hover:text-indigo-800" %>
      <%= link_to "Удалить", task,
            data: { turbo_method: :delete, turbo_confirm: "Удалить задачу?" },
            class: "text-red-600 hover:text-red-800" %>
    </div>
  </div>
</div>