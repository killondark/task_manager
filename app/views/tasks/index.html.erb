<h1>Задачи</h1>

<%= link_to "Новая задача", new_task_path %>

<%= form_with url: tasks_path, method: :get do |form| %>
  <div class="field">
    <%= form.label :status, "Статус" %>
    <%= form.select :status, options_for_select(["", *Task.statuses.keys], params[:status]), { include_blank: "Все" } %>
  </div>

  <div class="field">
    <%= form.label :priority, "Приоритет" %>
    <%= form.number_field :priority, value: params[:priority] %>
  </div>

  <%= form.submit "Фильтровать" %>
  <%= link_to "Сбросить", tasks_path %>
<% end %>

<table>
  <thead>
    <tr>
      <th>Заголовок</th>
      <th>Статус</th>
      <th>Приоритет</th>
      <th>Действия</th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= link_to task.title, task %></td>
        <td><%= task.status.humanize %></td>
        <td><%= task.priority %></td>
        <td>
          <%= link_to "Редактировать", edit_task_path(task) %>
          <%= link_to "Удалить", task, data: { turbo_method: :delete, turbo_confirm: "Удалить задачу?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>