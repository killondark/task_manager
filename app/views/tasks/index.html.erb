<% content_for :title, "Задачи" %>

<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold text-slate-900">Задачи</h1>
  <%= link_to "Новая задача",
        new_task_path,
        data: { turbo_frame: "task_modal" },
        class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-indigo-700" %>
</div>

<%= form_with url: tasks_path, method: :get, class: "mt-6 flex flex-wrap items-end gap-4 rounded-xl bg-white p-4 shadow-sm border border-slate-100" do |form| %>
  <div class="field">
    <%= form.label :status, "Статус", class: "mb-1 block text-sm font-medium text-slate-700" %>
    <%= form.select :status, options_for_select(["", *Task.statuses.keys], params[:status]),
          { include_blank: "Все" },
          class: "rounded-lg border border-slate-200 px-3 py-2 text-slate-800 focus:border-indigo-500 focus:outline-none" %>
  </div>

  <div class="field">
    <%= form.label :priority, "Приоритет", class: "mb-1 block text-sm font-medium text-slate-700" %>
    <%= form.number_field :priority, value: params[:priority], class: "rounded-lg border border-slate-200 px-3 py-2 text-slate-800 focus:border-indigo-500 focus:outline-none" %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit "Фильтровать", class: "rounded-lg bg-slate-800 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-slate-700" %>
    <%= link_to "Сбросить", tasks_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
  </div>
<% end %>

<%= turbo_frame_tag "task_modal" %>

<% if @tasks.any? %>
  <div id="tasks_list" class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
    <%= render partial: "task_card", collection: @tasks, as: :task %>
  </div>
<% else %>
  <div id="tasks_list" class="mt-6">
    <p class="rounded-xl bg-white p-6 text-center text-slate-500 shadow-sm border border-slate-100">
      Задач пока нет.
    </p>
  </div>
<% end %>